<!-- CritterEmote_ResponseEdit @VERSION@ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
	<Frame name="CritterEmoteResponseEditFrame" parent="UIParent" enableMouse="true" movable="true" hidden="true" resizable="false">
		<Size x="350" y="300"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parent_Title" inherits="GameFontNormalLarge">
					<Anchors>
						<Anchor point="TOP">
							<Offset><AbsDimension x="0" y="-16"/></Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<Texture name="$parent_Icon">
					<Size x="64" y="64"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
</Ui>